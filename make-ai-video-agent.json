{
  "name": "AI Video Agent - Daily YouTube Upload",
  "flow": [
    {
      "id": 1,
      "module": "openai-gpt-3:CreateCompletion",
      "version": 1,
      "parameters": {
        "__IMTCONN__": "YOUR_OPENAI_CONNECTION_ID"
      },
      "mapper": {
        "model": "gpt-4o",
        "select": "chat",
        "max_tokens": 2048,
        "temperature": 0.9,
        "messages": [
          {
            "role": "system",
            "content": "You are a YouTube content creator specializing in tech tips and AI news. You create engaging, concise video scripts that work well with AI avatar presenters. Keep scripts under 2 minutes of speaking time (~300 words). Be energetic and conversational."
          },
          {
            "role": "user",
            "content": "Create a new YouTube video about tech tips and AI news. Pick a specific trending or evergreen topic. Respond in EXACTLY this format:\n\nTITLE: <catchy YouTube title under 70 chars>\n\nDESCRIPTION: <YouTube description, 2-3 sentences with keywords>\n\nTAGS: <comma-separated tags, 5-8 tags>\n\nSCRIPT:\n<the full spoken script for the AI avatar, no stage directions>"
          }
        ]
      },
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "notes": "ChatGPT generates the script, title, description, and tags in plain text format."
      }
    },
    {
      "id": 2,
      "module": "heygen:createAnAvatarVideoV2",
      "version": 1,
      "parameters": {
        "__IMTCONN__": "YOUR_HEYGEN_CONNECTION_ID"
      },
      "mapper": {
        "test": false,
        "title": "AI Generated Video",
        "dimension": {
          "width": "1080",
          "height": "1920"
        },
        "video_inputs": [
          {
            "voice": {
              "type": "text",
              "speed": "1",
              "emotion": "Soothing",
              "voice_id": "YOUR_HEYGEN_VOICE_ID",
              "input_text": "{{1.result}}"
            },
            "character": {
              "type": "avatar",
              "scale": "1",
              "offset": {},
              "matting": false,
              "avatar_id": "YOUR_HEYGEN_AVATAR_ID",
              "avatar_style": "normal"
            },
            "background": {
              "type": "color",
              "value": "#f6f6fc"
            }
          }
        ]
      },
      "metadata": {
        "designer": { "x": 300, "y": 0 },
        "notes": "Creates a HeyGen AI avatar video using the script from module 1. Set your avatar ID and voice ID from your HeyGen account."
      }
    },
    {
      "id": 3,
      "module": "util:FunctionSleep",
      "version": 1,
      "parameters": {},
      "mapper": {
        "duration": "300"
      },
      "metadata": {
        "designer": { "x": 500, "y": 0 },
        "notes": "Waits 5 minutes (300s max) for HeyGen to render the video. HeyGen can take 5-15 min. If your video often isn't ready, run the scenario again manually after waiting longer."
      }
    },
    {
      "id": 4,
      "module": "heygen:getVideo",
      "version": 1,
      "parameters": {
        "__IMTCONN__": "YOUR_HEYGEN_CONNECTION_ID"
      },
      "mapper": {
        "video_id": "{{2.video_id}}"
      },
      "metadata": {
        "designer": { "x": 700, "y": 0 },
        "notes": "Fetches the video status from HeyGen. Returns video_url when ready, null when still processing."
      }
    },
    {
      "id": 5,
      "module": "http:ActionGetFile",
      "version": 3,
      "parameters": {},
      "filter": {
        "name": "Video Ready",
        "conditions": [
          [
            {
              "a": "{{4.data.video_url}}",
              "o": "exist"
            }
          ]
        ]
      },
      "mapper": {
        "url": "{{4.data.video_url}}",
        "serializeUrl": false,
        "shareCookies": false
      },
      "metadata": {
        "designer": { "x": 900, "y": 0 },
        "notes": "Downloads the rendered video. The filter prevents execution if video_url is still null (video still processing) — this is the fix for the BundleValidationError."
      }
    },
    {
      "id": 6,
      "module": "youtube:uploadVideo",
      "version": 4,
      "parameters": {
        "__IMTCONN__": "YOUR_YOUTUBE_CONNECTION_ID"
      },
      "mapper": {
        "data": "{{5.data}}",
        "title": "AI Generated Video",
        "fileName": "ai_video.mp4",
        "categoryId": "28",
        "description": "Generated with AI",
        "madeForKids": false,
        "privacyStatus": "public",
        "syntheticMedia": true
      },
      "metadata": {
        "designer": { "x": 1200, "y": 0 },
        "notes": "Uploads to YouTube. categoryId 28 = Science & Technology. Change to: 22=People&Blogs, 24=Entertainment, 26=HowTo, 27=Education."
      }
    }
  ],
  "metadata": {
    "instant": false,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "eu2.make.com"
  },
  "scheduling": {
    "type": "indefinitely",
    "interval": 1440
  }
}
